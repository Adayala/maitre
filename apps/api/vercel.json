{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd ../.. && npm install",
  "buildCommand": "cd ../.. && npm run build --workspace apps/api",
  "outputDirectory": "public",
  "regions": ["pdx1"],
  "functions": {
    "api/serverless.ts": { "maxDuration": 30 }
  },
  "crons": [
    {
      "path": "/internal/fiscal/invoice-deliveries/process",
      "schedule": "0 3 * * *"
    }
  ],
  "rewrites": [{ "source": "/(.*)", "destination": "/api/serverless" }]
}
