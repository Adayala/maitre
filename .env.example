SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
## ARCA electronic invoicing
# simulated: fake CAE for local development only; wsfev1: real ARCA SOAP services.
FISCAL_ARCA_DRIVER=simulated
# Production additionally requires an active entity/certificate, active branch,
# ARCA domicile, and VERIFIED point-of-sale evidence.
ARCA_HTTP_TIMEOUT_MS=15000
# Homologation credentials obtained through ARCA WSASS. Prefer injecting these
# from a secret manager; literal \\n sequences are accepted.
ARCA_HOMOLOGATION_CUIT=
ARCA_HOMOLOGATION_CERTIFICATE_PEM=
ARCA_HOMOLOGATION_PRIVATE_KEY_PEM=
# Production credentials are deliberately separate from homologation.
ARCA_PRODUCTION_CUIT=
ARCA_PRODUCTION_CERTIFICATE_PEM=
ARCA_PRODUCTION_PRIVATE_KEY_PEM=
## Fiscal document email delivery (server-side only)
RESEND_API_KEY=
FISCAL_EMAIL_FROM=Maitre <facturas@example.com>
